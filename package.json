{
  "name": "tianxuan",
  "version": "0.1.0",
  "description": "天玄 TianXuan — 多神经系统协同的小型语言模型 (Transformer + RNN 混合架构)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
